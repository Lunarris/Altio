<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>Lunarris</Author>
    <Name>Altio</Name>
    <Punchline>Cutscene-style dialogue and a light editor for GPose.</Punchline>
    <Description>Altio adds game-styled dialogue boxes and speech bubbles you can place on screen, plays dialogue scripts line by line like a cutscene, and edits the lights you make in Brio or the GPose menu, including gobo textures.
Dialogue overlays and gobos are adapted from Ktisis (GPL-3.0).</Description>
    <RepoUrl>https://github.com/Lunarris/Altio</RepoUrl>
    <Tags>gpose;brio;dialogue;lighting;cutscene</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KamiToolKit" Version="2.2.66" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lights\gobos.csv" LogicalName="Altio.gobos.csv" />
  </ItemGroup>
</Project>
